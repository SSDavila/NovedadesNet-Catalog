generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "ERD.svg"
}

// ==============================================================================
// == Authentication & Users
// ==============================================================================

model User {
  userId        Int      @id @default(autoincrement())
  userEmail     String   @unique
  userName      String
  userPassword  String
  userRole      String   @default("VENDEDOR")
  userIsActive  Boolean  @default(true)
  userCreatedAt DateTime @default(now())
  userUpdatedAt DateTime @updatedAt

  customer  Customer?
  saleNotes          SaleNote[]
  invoices           Invoice[]
  inventoryMovements InventoryMovement[]
}

// ==============================================================================
// == Company Information
// ==============================================================================

model Company {
  companyId              Int      @id @default(autoincrement())
  companyRuc             String   @unique
  companyName            String
  companyTradeName       String?
  companyAddress         String
  companyPhone           String?
  companyEmail           String?
  companyObligedToAccount String   @default("NO")
  companyLogoUrl         String?
  sriEnvironment         String   @default("1") // 1 = Pruebas, 2 = Producción
  sriEmissionType        String   @default("1") // 1 = Normal, 2 = Contingencia
  sriCertificatePath     String? // Path to .p12 certificate file
  sriCertificatePassword String? // Electronic signature password
  companyEstablishmentCode String?  @default("001")
  companyEmissionPointCode String?  @default("001")
  companyCreatedAt       DateTime @default(now())
  companyUpdatedAt       DateTime @updatedAt
}

// ==============================================================================
// == Customers
// ==============================================================================

model Customer {
  customerId                   String   @id
  customerIdentificationType   String   @default("CONSUMIDOR_FINAL")
  customerIdentificationNumber String   @unique
  customerName                 String
  customerEmail                String
  customerPhone                String?
  customerAddress              String?
  customerCreatedAt            DateTime @default(now())
  customerUpdatedAt            DateTime @updatedAt

  userId    Int?       @unique
  user      User?      @relation(fields: [userId], references: [userId])
  saleNotes SaleNote[]
  invoices  Invoice[]
}

// ==============================================================================
// == Products & Inventory
// ==============================================================================

model Product {
  productId                String   @id
  productName              String
  productDescription       String?
  productSku               String?  @unique
  productBarcode           String?  @unique
  productPrice             Decimal  @db.Decimal(10, 2)
  productPreviousPrice     Decimal? @db.Decimal(10, 2)
  productCost              Decimal? @db.Decimal(10, 2)
  productStock             Int      @default(0)
  productIvaRate           String   @default("0")
  productLowStockThreshold Int?     @default(5)
  productCreatedAt         DateTime @default(now())
  productUpdatedAt         DateTime @updatedAt

  categoryId         String?
  category           Category?           @relation(fields: [categoryId], references: [categoryId])
  images             ProductImage[]
  inventoryMovements InventoryMovement[]
  saleNoteItems      SaleNoteItem[]
  invoiceItems       InvoiceItem[]
}

model ProductImage {
  productImageId       String @id
  productImageUrl      String
  productImagePublicId String @unique

  productId String
  product   Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
}

model Category {
  categoryId           String  @id
  categoryName         String  @unique
  categoryAbbreviation String? @unique

  products Product[]
}

model InventoryMovement {
  inventoryMovementId        Int       @id @default(autoincrement())
  inventoryMovementType      String
  inventoryMovementQuantity  Int
  inventoryMovementReason    String?
  inventoryMovementCreatedAt DateTime  @default(now())

  // Relations
  productId                  String
  product                    Product   @relation(fields: [productId], references: [productId], onDelete: Cascade)
  userId                     Int
  user                       User      @relation(fields: [userId], references: [userId]) // ID del usuario que realiza el movimiento
  saleNoteId                 Int?
  saleNote                   SaleNote? @relation(fields: [saleNoteId], references: [saleNoteId], onDelete: SetNull)
  invoiceId                  Int?
  invoice                    Invoice?  @relation(fields: [invoiceId], references: [invoiceId], onDelete: SetNull)
}

// ==============================================================================
// == Sale Notes
// ==============================================================================

model SaleNote {
  saleNoteId        Int      @id @default(autoincrement())
  saleNoteNumber    String   @unique
  saleNoteStatus    String   @default("PENDIENTE")
  saleNoteTotal     Decimal  @db.Decimal(10, 2)
  saleNoteCreatedAt DateTime @default(now())
  saleNoteUpdatedAt DateTime @updatedAt

  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [customerId])
  sellerId           Int
  seller             User                @relation(fields: [sellerId], references: [userId])
  items              SaleNoteItem[]
  invoice            Invoice?

  inventoryMovements InventoryMovement[]
}

model SaleNoteItem {
  saleNoteItemId        Int     @id @default(autoincrement())
  saleNoteItemQuantity  Int
  saleNoteItemUnitPrice Decimal @db.Decimal(10, 2)
  saleNoteItemSubtotal  Decimal @db.Decimal(10, 2)

  saleNoteId Int
  saleNote   SaleNote @relation(fields: [saleNoteId], references: [saleNoteId], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [productId])
}

// ==============================================================================
// == Invoices
// ==============================================================================

model Invoice {
  invoiceId               Int      @id @default(autoincrement())
  invoiceNumber           String   @unique
  invoiceAccessKey        String   @unique
  invoiceStatus           String   @default("PENDIENTE")
  invoiceSubtotal         Decimal  @db.Decimal(10, 2)
  invoiceTax              Decimal  @default(0) @db.Decimal(10, 2)
  invoiceDiscountTotal    Decimal  @default(0) @db.Decimal(10, 2)
  invoiceTotal            Decimal  @db.Decimal(10, 2)
  invoiceSriAuthorization String?
  invoiceSriResponse      String?
  invoiceSignedXml        String?  @db.Text
  invoiceCreatedAt        DateTime @default(now())
  invoiceUpdatedAt        DateTime @updatedAt

  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [customerId])
  sellerId           Int
  seller             User                @relation(fields: [sellerId], references: [userId])
  saleNoteId         Int?                @unique
  saleNote           SaleNote?           @relation(fields: [saleNoteId], references: [saleNoteId])

  items              InvoiceItem[]
  inventoryMovements InventoryMovement[]
  payments           Payment[]
}

model InvoiceItem {
  invoiceItemId        Int     @id @default(autoincrement())
  invoiceItemQuantity  Int
  invoiceItemUnitPrice Decimal @db.Decimal(10, 2)
  invoiceItemDiscount  Decimal @default(0) @db.Decimal(10, 2)
  invoiceItemSubtotal  Decimal @db.Decimal(10, 2)

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [productId])
}

// ==============================================================================
// == Payments
// ==============================================================================

model Payment {
  paymentId        Int      @id @default(autoincrement())
  paymentMethod    String
  paymentAmount    Decimal  @db.Decimal(10, 2)
  paymentReference String?
  paymentDate      DateTime @default(now())
  paymentCreatedAt DateTime @default(now())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
}

// ==============================================================================
// == Sequence Control
// ==============================================================================

model SequenceControl {
  sequenceId        Int      @id @default(autoincrement())
  documentType      String // FACTURA, NOTA_CREDITO, etc.
  establishmentCode String // Ej: "001"
  emissionPointCode String // Ej: "001"
  currentNumber     Int      @default(1)
  updatedAt         DateTime @updatedAt

  @@unique([documentType, establishmentCode, emissionPointCode])
}
