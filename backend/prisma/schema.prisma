generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId       Int      @id @default(autoincrement())
  userType     String   @default("customer")
  userName     String
  userEmail    String   @unique
  userPassword String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  prodId          String         @id
  prodName        String
  prodDescription String?
  prodPrice       Decimal        @db.Decimal(10, 2)
  prodPreviousPrice   Decimal?       @db.Decimal(10, 2)
  prodCategory    String?
  prodStock       Int            @default(0)
  prodImages      ProductImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProductImage {
  prodImageId        String   @id
  prodImageUrl       String
  prodImagePublicid  String   @unique
  product   Product  @relation(fields: [prodId], references: [prodId], onDelete: Cascade, onUpdate: Cascade)
  prodId String
}

model Category {
  categoryId   String @id
  categoryName String @unique
  categoryAbbreviation String? @unique
}